{
  "manifest_version": 1,
  "id": "pixel",
  "name": "像素化",
  "version": "0.1.0",
  "description": "把图片转成像素画",
  "icon": "pixel",
  "publisher": {
    "id": "atelier",
    "name": "Atelier"
  },
  "sdk_version": "1",
  "app_version": {
    "min": "5.137.0"
  },
  "ui": {
    "entry": "ui/index.html"
  },
  "capabilities": [
    "node.read_self",
    "node.write_self",
    "resource.read_inputs",
    "resource.create",
    "server.call"
  ],
  "contributes": {
    "nodes": [
      {
        "type": "pixelate",
        "title": "像素化",
        "icon": "pixel",
        "default_size": {
          "width": 320,
          "height": 280
        },
        "min_size": {
          "width": 240,
          "height": 200
        },
        "payload_schema_version": 1,
        "input_modalities": [
          "image"
        ],
        "max_inputs": 1,
        "surfaces": [
          "node",
          "panel"
        ],
        "expand_result_stack": true
      }
    ],
    "image_actions": [
      {
        "id": "pixelate",
        "label": "像素化",
        "icon": "pixel",
        "action": {
          "kind": "create_node",
          "node_type": "pixelate",
          "open_panel": true
        }
      }
    ],
    "server": {
      "module": "server",
      "routes": [
        {
          "method": "POST",
          "path": "/presets",
          "access": "read"
        },
        {
          "method": "POST",
          "path": "/palette",
          "access": "read"
        },
        {
          "method": "POST",
          "path": "/preview",
          "access": "read"
        },
        {
          "method": "POST",
          "path": "/pixelate",
          "access": "edit"
        }
      ]
    },
    "agent_tools": [
      {
        "name": "pixelate",
        "description": "把图片转成像素画：降采样到目标像素网格、限定调色板（自动、预设或自定义）、可选抖动、去杂点与外描边，可按整数倍放大输出。多张时输出一个结果组。",
        "parameters": {
          "type": "object",
          "required": [
            "image_node_ids"
          ],
          "properties": {
            "image_node_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 65,
              "items": {
                "type": "string"
              },
              "description": "要像素化的图片节点 id；多张时按顺序输出一个结果组，默认共用一个调色板"
            },
            "size_mode": {
              "type": "string",
              "enum": [
                "long_edge",
                "block"
              ],
              "description": "long_edge：按长边像素数；block：按几个原像素合成一格"
            },
            "long_edge": {
              "type": "integer",
              "minimum": 8,
              "maximum": 512,
              "description": "目标长边像素数，默认 64"
            },
            "block": {
              "type": "integer",
              "minimum": 2,
              "maximum": 64,
              "description": "像素块大小，默认 8"
            },
            "downsample": {
              "type": "string",
              "enum": [
                "mode",
                "average"
              ],
              "description": "mode：格内主色（默认，像素画）；average：格内平均（照片类）"
            },
            "palette": {
              "type": "object",
              "description": "调色板：{kind:'auto', colors:2–64} 自动聚类；{kind:'preset', preset:'pico-8'|'gameboy'|'db16'|'db32'|'endesga-32'|'nes'}；{kind:'custom', custom:'#RRGGBB …'}",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "preset",
                    "custom"
                  ]
                },
                "colors": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 64
                },
                "preset": {
                  "type": "string",
                  "enum": [
                    "pico-8",
                    "gameboy",
                    "db16",
                    "db32",
                    "endesga-32",
                    "nes"
                  ]
                },
                "custom": {
                  "type": "string"
                }
              }
            },
            "shared_palette": {
              "type": "boolean",
              "description": "多张时共用一个调色板，默认是"
            },
            "alpha_threshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255,
              "description": "透明度低于它的像素变成全透明，默认 128"
            },
            "upscale": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16,
              "description": "输出按整数倍最近邻放大，默认 1"
            },
            "keep_original_size": {
              "type": "boolean",
              "description": "放大时另外输出实际像素尺寸的版本"
            },
            "dither": {
              "type": "object",
              "description": "抖动：kind 为 none / bayer2 / bayer4 / bayer8 / floyd，strength 0–100（Bayer 用）",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "none",
                    "bayer2",
                    "bayer4",
                    "bayer8",
                    "floyd"
                  ]
                },
                "strength": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            },
            "cleanup": {
              "type": "object",
              "description": "清理：isolated 为 0 / 4 / 8（按 4 或 8 邻域去孤立像素），min_region 为 0–16（合并面积小于它的色块）",
              "properties": {
                "isolated": {
                  "type": "integer",
                  "enum": [
                    0,
                    4,
                    8
                  ]
                },
                "min_region": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16
                }
              }
            },
            "outline": {
              "type": "object",
              "description": "外描边 1 像素：enabled，connectivity 4 / 8，color 为 'darkest'（调色板最深色）或 #RRGGBB",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "connectivity": {
                  "type": "integer",
                  "enum": [
                    4,
                    8
                  ]
                },
                "color": {
                  "type": "string"
                }
              }
            }
          }
        },
        "read_only": false,
        "route": "/pixelate"
      }
    ]
  },
  "files": [
    {
      "path": "ui/index.html",
      "sha256": "6a8df6482ece6f1c4cc217189ea8ee4db81991112bcc89f471cd82e9b15edc20",
      "bytes": 162733
    }
  ],
  "source": "bundled",
  "digest": "sha256:9b103ec9e8cc6864345d4c3ad38bcc98bb099905a9917d2567a0e15b9a2d5070"
}
