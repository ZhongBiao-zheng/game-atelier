{
  "manifest_version": 1,
  "id": "ps-bridge",
  "name": "PS 联动",
  "version": "0.1.0",
  "description": "和 PS 互传图片",
  "icon": "exchange",
  "publisher": {
    "id": "atelier",
    "name": "Atelier"
  },
  "sdk_version": "1",
  "app_version": {
    "min": "5.138.0"
  },
  "runtime": "host",
  "contributes": {
    "nodes": [],
    "image_actions": [
      {
        "id": "place",
        "label": "发到 Photoshop",
        "icon": "export",
        "action": {
          "kind": "host_call"
        }
      }
    ],
    "canvas_actions": [
      {
        "id": "import_merged",
        "label": "从 Photoshop 取图",
        "icon": "add-image",
        "action": {
          "kind": "host_call"
        }
      },
      {
        "id": "import_layer",
        "label": "从 Photoshop 取图层",
        "icon": "layers",
        "action": {
          "kind": "host_call"
        }
      }
    ],
    "server": {
      "module": "server",
      "routes": [
        {
          "method": "POST",
          "path": "/status",
          "access": "read"
        },
        {
          "method": "POST",
          "path": "/import",
          "access": "edit"
        },
        {
          "method": "POST",
          "path": "/place",
          "access": "read"
        }
      ]
    }
  },
  "files": [],
  "source": "bundled",
  "digest": "sha256:45226e953352ea5cf795789deb7d66850dcb30f42164809eeaf7dafd797f5469"
}
