# 图片资产 — 全部本地化，不进 Git
# 包括流程图素材、角色出图 PNG、参考图副本等
images/
*.png
*.jpg
*.jpeg
*.webp
*.gif

# Skill 运行时状态（每个画师本地一份）
.runtime/

# API 密钥与本地配置（绝不进 Git）
.config/

# viewer-server / Studio 运行时 job 状态
studio/

# 项目内记忆（个人会话日志，不上线）
memory/

# 历史归档（旧设计稿、过时计划、外部 skill 残留等）
archive/

# Claude Code 本地状态（dev-link 创建的 skill 符号链接、worktrees 等）
.claude/

# OS / IDE
.DS_Store
**/.DS_Store
Thumbs.db
.vscode/
.idea/

# Node / Python
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# 前端构建产物（由 vite build 生成）
web/dist/

# tsc -b 的中间产物（与 .tsx 源同目录生成的 .js / .tsbuildinfo）
web/src/**/*.js
web/tsconfig.tsbuildinfo

# pnpm 内部生成
web/pnpm-workspace.yaml

.gstack/
