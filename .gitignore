# 图片资产 — 全部本地化，不进 Git
# 包括流程图素材、角色出图 PNG、参考图副本等
images/
*.png
*.jpg
*.jpeg
*.webp
*.gif

# 例外：design-system/references/ 下的风格基线参考图保留追踪
!design-system/references/**/*.png
!design-system/references/**/*.jpg
!design-system/references/**/*.jpeg
!design-system/references/**/*.webp

# Skill 运行时状态（每个画师本地一份）
.runtime/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node / Python
node_modules/
__pycache__/
*.pyc
.venv/
venv/
