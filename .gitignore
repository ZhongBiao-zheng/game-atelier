# 图片资产 — 全部本地化，不进 Git
# 包括流程图素材、角色出图 PNG、参考图副本等
images/
*.png
*.jpg
*.jpeg
*.webp
*.gif

# 角色数据与项目数据（每个画师本地一份，dev 模式 data root 指向仓库根时产生）
characters/
projects/

# Skill 运行时状态（每个画师本地一份）
.runtime/

# API 密钥与本地配置（绝不进 Git）
.config/

# viewer-server / Studio 运行时 job 状态（只忽略仓库根的 studio/ 目录）
/studio/

# 项目内记忆（个人会话日志，不上线）
memory/
MEMORY.md
worldview.md

# 开发过程文档（设计方案、实施计划、superpowers 日志，仅开发者本地可见）
docs/plans/
docs/superpowers/

# 本地需求草稿与执行记录；长期产品规则提炼到 docs 后提交
/.scratch/

# 历史归档（旧设计稿、过时计划、外部 skill 残留等）
archive/

# Claude Code 本地状态（dev-link 创建的 skill 符号链接、worktrees 等）
.claude/

# OS / IDE
.DS_Store
**/.DS_Store
Thumbs.db
.vscode/
.idea/

# Node / Python
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# 前端构建产物（web/dist）随插件分发：市场装走 git，必须带预构建 UI，
# 否则 viewer-server 无前端可挂、开窗 404。发版前务必 `make build` 再 commit。
# 故 web/dist/ 不再 ignore（见 docs/plans/2026-06-03-首启bootstrap...）。

# tsc -b 的中间产物（与 .tsx 源同目录生成的 .js / .tsbuildinfo）
web/src/**/*.js
web/tsconfig.tsbuildinfo

.gstack/
